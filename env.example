# Environment Variables Configuration Example for BFR-WEBUI-GO
# Copy or set any of these environment variables to customize paths and binaries.
# Default values will be automatically used if left unset/commented.

# Target HTTP port for the WebUI server (default: 8080)
# PORT=8080

# WebUI Admin authentication password (default: "bfr")
# BFR_PASSWORD=bfr

# Root command binary name or path (default: "su", e.g. "ksu", "apatch", "/system/xbin/su")
# BFR_SU_BIN=su

# Base directory path of the BFR Magisk/KSU module (default: "/data/adb/modules/bfr_webui_go")
# BFR_MODULE_DIR=/data/adb/modules/bfr_webui_go

# Custom base path override for Box module directories (default: "/data/adb/box")
# BFR_BOX_BASE=/data/adb/box

# Custom base path override for Clash / Mihomo configuration directories (default: "/data/adb/clash")
# BFR_CLASH_BASE=/data/adb/clash

# Clash / Mihomo external controller HTTP endpoint (default: "http://127.0.0.1:9090")
# BFR_CLASH_API=http://127.0.0.1:9090

# Optional custom SMS SQLite database file path (default: auto-scanned ROM paths)
# BFR_SMS_DB=/data/data/com.android.providers.telephony/databases/mmssms.db

# Optional custom dnsmasq.leases path for SoftAP client parsing (default: "/data/misc/dhcp/dnsmasq.leases")
# BFR_LEASES_FILE=/data/misc/dhcp/dnsmasq.leases

# Comma-separated list of allowed base directories for File Manager operations
# BFR_ALLOWED_DIRS=/sdcard,/storage,/data/adb,/data/local/tmp,/data/system
