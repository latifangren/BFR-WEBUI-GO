# LTE/5G Carrier Aggregation
gsm.lte.ca.support=1
persist.radio.lte_ca=1
vendor.radio.lte_ca=1
persist.sys.cnd.iwlan.enable=1
persist.radio.rat_on=combine
persist.radio.data_ltd_sys_ind=1
persist.radio.data_con_rrc=1

# TCP & Network Stack Optimization
net.tcp.buffersize.default=4096,87380,256000,4096,16384,256000
net.tcp.buffersize.wifi=524288,1048576,2097152,262144,524288,1048576
net.tcp.buffersize.lte=524288,1048576,2097152,262144,524288,1048576
net.tcp.buffersize.5g=2097152,4194304,8388608,1048576,2097152,4194304
net.tcp.buffersize.umts=4094,87380,256000,4096,16384,256000
net.tcp.buffersize.hsdpa=4094,87380,256000,4096,16384,256000
net.tcp.buffersize.hspa=4094,87380,256000,4096,16384,256000
net.tcp.buffersize.gprs=4092,87380,11680,4092,87380,11680
net.tcp.buffersize.edge=4093,26280,35040,4093,16384,35040

# TCP BBR Congestion Control
net.ipv4.tcp_congestion_control=bbr2
net.core.default_qdisc=fq

# System & Responsiveness Tweaks
persist.sys.use_dithering=0
persist.sys.purgeable_assets=1
persist.sys.scrollingcache=3
ro.config.max_starting_bg=8
ro.sys.fw.bg_apps_limit=32
dalvik.vm.heapgrowthlimit=256m
dalvik.vm.heapsize=512m
dalvik.vm.heapstartsize=8m
dalvik.vm.heaptargetutilization=0.75
dalvik.vm.heapminfree=512k
dalvik.vm.heapmaxfree=8m
dalvik.vm.execution-mode=int:jit
dalvik.vm.dex2oat-filter=speed
